{
  "name": "mobx-view-model-devtools",
  "version": "0.3.1",
  "description": "DevTools for mobx-view-model — inspect and debug ViewModel instances in real time",
  "keywords": [
    "mobx",
    "view-model",
    "devtools",
    "debug"
  ],
  "author": "js2me",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/js2me/mobx-view-model/issues"
  },
  "homepage": "https://github.com/js2me/mobx-view-model",
  "repository": {
    "type": "git",
    "url": "https://github.com/js2me/mobx-view-model"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "clean": "rimraf dist",
    "check": "pnpm lint && tsc --noEmit --project tsconfig.check.json && pnpm check:stories && pnpm check:compatibility",
    "build:dev": "cross-env NODE_ENV=development tsx scripts/build",
    "build": "tsc --noEmit --project tsconfig.check.json && cross-env NODE_ENV=production tsx scripts/build",
    "build:dev:global-only": "cross-env NODE_ENV=development GLOBAL_ONLY=true tsx scripts/build",
    "build:dev:watch": "nodemon --watch src --delay 600ms --ext ts,tsx,css --exec \"pnpm build:dev\"",
    "build:dev:watch-global-only": "nodemon --watch src --delay 600ms --ext ts,tsx,css --exec \"pnpm build:dev:global-only\"",
    "serve": "pnpm exec http-server dist -p 15000",
    "build:watch-server": "nodemon --watch src --delay 600ms --ext ts,tsx,css --exec \"pnpm build && pnpm serve\"",
    "build:watch-server-global-only": "nodemon --watch src --delay 600ms --ext ts,tsx,css --exec \"pnpm build:dev:global-only && pnpm serve\"",
    "test:e2e": "pnpm --workspace-root build && playwright test --config playwright.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "lint": "biome check src tests scripts stories .storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "check:stories": "tsc --noEmit --project tsconfig.stories.json",
    "measure:performance": "node scripts/measure-performance.mjs",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:e2e:container": "bash scripts/test-browser-container.sh",
    "capture:docs": "node scripts/capture-docs-screenshots.mjs",
    "check:compatibility": "tsc --noEmit --project tsconfig.compatibility.json"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.18.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "mobx-swiss-knife": "^1.15.0",
    "mobx-view-model": "workspace:*",
    "mobx-view-model-react": "workspace:*",
    "mobx-web-api": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplebar-core": "^1.3.2",
    "yummies": "^7.20.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "lodash-es": "^4.17.21",
    "mobx-solid": "^0.3.1",
    "mobx-view-model-solid": "workspace:*",
    "mobx-view-model-v10": "npm:mobx-view-model@10.2.2",
    "mobx-view-model-v8": "npm:mobx-view-model@8.10.1",
    "mobx-view-model-v8-initial": "npm:mobx-view-model@8.0.0",
    "mobx-view-model-v9": "npm:mobx-view-model@9.3.16",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "postcss-selector-parser": "^7.1.1",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "solid-js": "^1.9.14",
    "storybook": "10.6.5",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-solid": "^2.11.13"
  }
}
